diff --git a/.github/workflows/pr-cross-platform.yml b/.github/workflows/pr-cross-platform.yml
new file mode 100644
index 00000000..3963d6b5
--- /dev/null
+++ b/.github/workflows/pr-cross-platform.yml
@@ -0,0 +1,45 @@
+name: PR cross-platform checks
+
+# PR-only portability gate: install, syntax, reconciled tests and build on
+# Linux, Windows and macOS. It never deploys, publishes or writes to the repo.
+on:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: pr-xplat-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  check:
+    name: ${{ matrix.os }}
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 20
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, windows-latest, macos-latest]
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+          cache: npm
+      - name: Install (npm ci)
+        run: npm ci --no-audit --no-fund
+      - name: Syntax
+        run: npm run check:syntax
+      - name: Tests (reconciled npm test)
+        run: npm test
+      - name: Build dist/
+        run: npm run build
+      - name: Line-ending policy holds
+        shell: bash
+        run: |
+          if git ls-files --eol | awk '$1 ~ /i\/crlf|i\/mixed/' | grep .; then
+            echo "CRLF/mixed files in the index"; exit 1; fi
