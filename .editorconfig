# Same editor behaviour on Mac, Windows and Linux. Matches .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[{Makefile,*.mk}]
indent_style = tab

[*.{png,jpg,jpeg,webp,avif,gif,ico,pdf,glb,blend,bin,woff,woff2,ttf,otf,zip,jar}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
